FROM debian:trixie

ENV DEBIAN_FRONTEND=noninteractive

# gh：review-pr 用 gh api / gh pr 发/改 PR 评论。
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        bash \
        git \
        gh \
        jq \
        tini \
    && rm -rf /var/lib/apt/lists/*

# pr-agent 的单一来源是 .ci/pr-agent.sh，本文件与 Dockerfile.pr-runner 共用，避免各存一份漂移。
COPY .ci/pr-agent.sh /usr/local/bin/pr-agent
RUN chmod +x /usr/local/bin/pr-agent

# UID 必须是 1001 且非 root：GitHub-hosted runner 以 runner 用户(1001)创建 /__w 与
# runner_file_commands，UID 不一致会让 actions/checkout 写 save_state 时 EACCES；
# dontAsk 模式也拒绝以 root 运行。
RUN useradd -m -s /bin/bash -u 1001 agent
USER agent
WORKDIR /home/agent

# 刻意不 pin 审查 CLI 版本：镜像按周期重建以跟进上游。
RUN curl -fsSL https://claude.ai/install.sh | bash

ENV PATH="/home/agent/.local/bin:${PATH}"

# GitHub Actions 以 root 克隆仓库、容器以 agent(1001) 运行，需禁用 dubious ownership 检查，
# 否则 gh pr diff / git diff / git log 全部报错。
RUN git config --global --add safe.directory '*'

# 手动构建并推送到 ghcr：
#   docker build -t ghcr.io/xiaomi/xiaomi-miloco/pr-review:trixie -f .ci/Dockerfile.pr-review .
#   docker push ghcr.io/xiaomi/xiaomi-miloco/pr-review:trixie
#
# 运行时注入：ANTHROPIC_API_KEY 必填；ANTHROPIC_BASE_URL 可选，但不能声明为空
# （空串会被 SDK 当无效 URL）；PR_AGENT_MODEL / GH_TOKEN 可选；
# ANTHROPIC_FALLBACK_API_KEY 与 PR_AGENT_FALLBACK_MODEL 同时配齐才触发降级，
# ANTHROPIC_FALLBACK_BASE_URL 不配则沿用主 endpoint（同一网关换 key/模型）；
#   要指向另一个服务商时必须显式配置，否则降级请求仍会发往主网关。
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/bin/bash"]
